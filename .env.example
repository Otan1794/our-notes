# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side in one-off admin scripts (e.g. manually creating
# the two user accounts). Never import this in a Server Action that runs
# on every request, and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
